{
  "name": "king-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/dev.mjs",
    "dev:hosted": "nuxt dev --dotenv .env",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "seed:king-works": "node --env-file=.env.development.local supabase/seed/load-king-works.ts",
    "seed:king-works:hosted": "node --env-file=.env supabase/seed/load-king-works.ts",
    "seed:bibliography": "node --env-file=.env.development.local supabase/seed/load-bibliography.ts",
    "seed:bibliography:hosted": "node --env-file=.env supabase/seed/load-bibliography.ts",
    "backfill:cover-ids": "node supabase/seed/backfill-cover-ids.ts",
    "backfill:tmdb-posters": "node --env-file=.env supabase/seed/backfill-tmdb-posters.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@supabase/supabase-js": "^2.112.4",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "supabase": "^2.116.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.24.0"
}
